#!/usr/bin/env bash
# Install/manage skills as symlinks into Claude and Cursor skill dirs.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLAUDE_DIR="$HOME/.claude/skills"
CURSOR_DIR="$HOME/.cursor/skills-cursor"

RED=$'\033[31m'; GRN=$'\033[32m'; YLW=$'\033[33m'; DIM=$'\033[2m'; RST=$'\033[0m'

targets=()
check_targets() {
  targets=()
  if [[ -d "$CLAUDE_DIR" ]]; then
    targets+=("claude:$CLAUDE_DIR")
  else
    echo "${YLW}warn:${RST} Claude skills dir not found: $CLAUDE_DIR"
  fi
  if [[ -d "$CURSOR_DIR" ]]; then
    targets+=("cursor:$CURSOR_DIR")
  else
    echo "${YLW}warn:${RST} Cursor skills dir not found: $CURSOR_DIR"
  fi
  if [[ ${#targets[@]} -eq 0 ]]; then
    echo "${RED}error:${RST} no install targets exist. Install Claude Code or Cursor first."
    exit 1
  fi
}

skill_path() {
  local name="$1"
  local p="$REPO_ROOT/$name"
  if [[ ! -d "$p" ]]; then
    echo "${RED}error:${RST} skill '$name' not found at $p" >&2
    exit 1
  fi
  if [[ ! -f "$p/SKILL.md" ]]; then
    echo "${RED}error:${RST} $p missing SKILL.md" >&2
    exit 1
  fi
  echo "$p"
}

list_skills() {
  find "$REPO_ROOT" -mindepth 2 -maxdepth 2 -name SKILL.md \
    -not -path "$REPO_ROOT/.git/*" \
    -not -path "$REPO_ROOT/.claude/*" \
    -not -path "$REPO_ROOT/bin/*" \
    | while read -r f; do basename "$(dirname "$f")"; done | sort -u
}

cmd_install() {
  local name="$1"
  local src; src="$(skill_path "$name")"
  check_targets
  for t in "${targets[@]}"; do
    local label="${t%%:*}" dir="${t#*:}"
    local link="$dir/$name"
    if [[ -L "$link" ]]; then
      local cur; cur="$(readlink "$link")"
      if [[ "$cur" == "$src" ]]; then
        echo "${DIM}=${RST} $label: $name already linked"
        continue
      fi
      echo "${YLW}~${RST} $label: relinking $name (was $cur)"
      rm "$link"
    elif [[ -e "$link" ]]; then
      echo "${RED}skip${RST} $label: $link exists and is not a symlink"
      continue
    fi
    ln -s "$src" "$link"
    echo "${GRN}+${RST} $label: $name -> $src"
  done
}

cmd_uninstall() {
  local name="$1"
  check_targets
  for t in "${targets[@]}"; do
    local label="${t%%:*}" dir="${t#*:}"
    local link="$dir/$name"
    if [[ -L "$link" ]]; then
      rm "$link"
      echo "${GRN}-${RST} $label: removed $name"
    elif [[ -e "$link" ]]; then
      echo "${RED}skip${RST} $label: $link is not a symlink, refusing to delete"
    else
      echo "${DIM}=${RST} $label: $name not installed"
    fi
  done
}

cmd_install_all() {
  local any=0
  while read -r name; do
    [[ -z "$name" ]] && continue
    any=1
    cmd_install "$name"
  done < <(list_skills)
  [[ $any -eq 0 ]] && echo "${YLW}no skills found in $REPO_ROOT${RST}"
}

cmd_list() {
  local skills; skills="$(list_skills)"
  if [[ -z "$skills" ]]; then
    echo "${DIM}(no skills in repo)${RST}"
    return
  fi
  check_targets
  printf "%-30s %-10s %-10s\n" "SKILL" "CLAUDE" "CURSOR"
  while read -r name; do
    local c="-" k="-"
    [[ -L "$CLAUDE_DIR/$name" ]] && c="${GRN}linked${RST}"
    [[ -L "$CURSOR_DIR/$name" ]] && k="${GRN}linked${RST}"
    [[ ! -d "$CLAUDE_DIR" ]] && c="${DIM}n/a${RST}"
    [[ ! -d "$CURSOR_DIR" ]] && k="${DIM}n/a${RST}"
    printf "%-30s %-19b %-19b\n" "$name" "$c" "$k"
  done <<< "$skills"
}

usage() {
  cat <<EOF
skills — manage personal skills for Claude Code and Cursor

USAGE
  skills install <name>     symlink one skill into Claude + Cursor
  skills install-all        symlink every skill in this repo
  skills uninstall <name>   remove symlinks for one skill
  skills list               show repo skills and install state

REPO   $REPO_ROOT
TARGETS
  Claude  $CLAUDE_DIR
  Cursor  $CURSOR_DIR
EOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
  install)        [[ $# -eq 1 ]] || { usage; exit 2; }; cmd_install "$1" ;;
  install-all)    cmd_install_all ;;
  uninstall)      [[ $# -eq 1 ]] || { usage; exit 2; }; cmd_uninstall "$1" ;;
  list|ls)        cmd_list ;;
  ""|-h|--help)   usage ;;
  *)              echo "${RED}unknown command:${RST} $cmd"; usage; exit 2 ;;
esac
